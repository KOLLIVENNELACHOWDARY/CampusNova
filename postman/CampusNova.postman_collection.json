      "auth": {
       "type": "noauth"
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('401 + standard error', ()=>{pm.response.to.have.status(401); pm.expect(pm.response.json().error.code).to.eql('unauthorized');});"
