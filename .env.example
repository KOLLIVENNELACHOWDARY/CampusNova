APP_NAME=CampusNova
APP_VERSION=1.0.0
ENVIRONMENT=development                # set to "production" in deployment (then SECRET_KEY must be changed)
DATABASE_URL=mysql+pymysql://campusnova_user:change_me@localhost:3306/campusnova
DB_SSL=false                           # true for hosted MySQL (Aiven / TiDB Cloud / Railway ...)
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
CORS_ORIGINS=http://localhost:5173
# photos are stored in the database
MAX_UPLOAD_MB=4
MAX_IMAGES_PER_COMPLAINT=5

# AI / automation
CAMPUSNOVA_AUTO_ASSIGN=1               # 0 = admins assign by hand
CAMPUSNOVA_SCHEDULER=0                 # 1 only on a long-running server; on Vercel use /cron/all (see docs/OPERATING_GUIDE.md)

CAMPUSNOVA_NOTIFY_MODE=log             # log = simulate (nothing leaves the machine) | live = real SMTP email + FCM push
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@campusnova.edu
# Firebase (Google sign-in + push). Service-account JSON pasted as ONE line; works on Vercel (no file needed)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=

# Vercel / GitHub Actions call /cron/* with this bearer token
CRON_SECRET=change-me-random

# Frontend (frontend/.env): VITE_API_URL=https://<your-api>.vercel.app  and VITE_FIREBASE_* (optional)
